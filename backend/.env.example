# Copy to backend/.env if you do not already have one, then fill in the values.
# Never commit your populated .env file. Restart the backend after changes.

# Required: OpenRouter account API key and an available Gemma model ID.
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
GEMMA_MODEL=replace_with_available_openrouter_gemma_model_id

# Optional OpenRouter application attribution. Use your website URL in production.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME="iHeat Sol"

# Local RAG configuration. Relative paths are resolved from the backend directory.
RAG_KNOWLEDGE_BASE_PATH=knowledge/corpus/knowledge_chunks.jsonl
RAG_INDEX_PATH=knowledge/index
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Rebuild with: ./venv/bin/python scripts/build_rag_index.py
# Rebuild the index whenever you change the corpus or embedding model.

# Retrieval relevance thresholds (scores, not probabilities).
RAG_MIN_SEMANTIC_SCORE=0.78
RAG_MIN_FINAL_SCORE=0.78

# Optional Hugging Face token for model downloads; leave unset if not needed.
# HF_TOKEN=replace_with_your_hugging_face_token
