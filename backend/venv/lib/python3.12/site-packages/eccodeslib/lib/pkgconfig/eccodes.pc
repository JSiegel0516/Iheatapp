# This pkg-config file is generated by ecbuild_pkgconfig()
# with template ecbuild/cmake/pkg-config.pc.in

git_tag=f7351a51f77940b3fdb1496b14adae3781cda39a

prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include
bindir=${prefix}/bin
fmoddir=${prefix}/include

CC=/usr/bin/cc
CXX=/usr/bin/c++
FC=

libs=-Wl,-rpath,${libdir} -L${libdir} -leccodes

libs_private=-Wl,-rpath,/tmp/openjpeg/target/lib -L/tmp/openjpeg/target/lib -lopenjp2 -Wl,-rpath,${libdir} -L${libdir} -leccodes_memfs -Wl,-rpath,/tmp/eccodes/prereqs/eckitlib/lib -L/tmp/eccodes/prereqs/eckitlib/lib -leckit_geo -Wl,-rpath,/tmp/eccodes/prereqs/eckitlib/lib -L/tmp/eccodes/prereqs/eckitlib/lib -leckit_codec -Wl,-rpath,/tmp/eccodes/prereqs/eckitlib/lib -L/tmp/eccodes/prereqs/eckitlib/lib -leckit_maths -Wl,-rpath,/tmp/eccodes/prereqs/eckitlib/lib -L/tmp/eccodes/prereqs/eckitlib/lib -leckit_spec -Wl,-rpath,/tmp/eccodes/prereqs/eckitlib/lib -L/tmp/eccodes/prereqs/eckitlib/lib -leckit -Wl,-rpath,/opt/homebrew/lib -L/opt/homebrew/lib -lpng -Wl,-rpath,/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib -L/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib -lz -l$<1:libaec::aec -lm

cflags=-I${includedir} -I/tmp/eccodes/target/eccodes/include

### Features:

HAVE_MEMFS=1
HAVE_GEOGRAPHY=1
HAVE_JPEG=1
HAVE_LIBJASPER=0
HAVE_LIBOPENJPEG=1
HAVE_ECCODES_THREADS=1
HAVE_ECCODES_OMP_THREADS=0
HAVE_NETCDF=0
HAVE_FORTRAN=0
HAVE_PNG=1
HAVE_AEC=1
HAVE_ECKIT_GEO=1

#====================================================================
Name: eccodes
Description: The ecCodes library
URL: https://confluence.ecmwf.int/display/ECC/
Version: 2.47.3
Libs: ${libs}
Libs.private: ${libs_private}
Requires: 
Requires.private: 
Cflags: ${cflags}
#====================================================================
