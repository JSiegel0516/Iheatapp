# Base URL of the FastAPI backend.
# Leave REACT_APP_API_URL UNSET. The app defaults to the relative path "/api",
# which the CRA dev server proxies to http://localhost:8080 (see "proxy" in
# package.json) and which Apache proxies in production. Set it only to point at
# a different host, e.g.:
#   REACT_APP_API_URL=https://some-other-host/api

# OpenRouter key used by the Chatbox component.
# WARNING: CRA bundles REACT_APP_* vars into the public client build, so this
# key is exposed to anyone who opens the app. Rotate it and proxy the call
# through the backend before deploying.
REACT_APP_OPENAI_API_KEY=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
