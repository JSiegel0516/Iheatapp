# Production environment for `npm run build`.
# CRA loads this file (over .env) whenever NODE_ENV=production.
#
# Same-origin RELATIVE path. The app is served from https://rhialarm.sdsu.edu,
# so requests go to https://rhialarm.sdsu.edu/api/... and Apache's
#     ProxyPass "/api/" "http://127.0.0.1:8080/api/"
# forwards them to the FastAPI backend. No cross-origin, no CORS, no mixed
# content. DO NOT put an absolute host here (that reintroduces the CORS error).
REACT_APP_API_URL=/api

# OpenRouter key for the Chatbox. NOTE: CRA bakes this into the public JS
# bundle, so anyone can read it. Rotate it and proxy through the backend
# before you rely on this in production.
REACT_APP_OPENAI_API_KEY=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
